# Environment files
.env
.env.*
!.env.example

# PHP / Composer
vendor/
**/vendor/

# Node / frontend
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel runtime/generated files
bootstrap/cache/*.php
**/bootstrap/cache/*.php
storage/framework/views/*.php
**/storage/framework/views/*.php
storage/logs/*.log
**/storage/logs/*.log

# SQLite local databases
*.sqlite
*.sqlite3

# Local work areas
_work/
**/_work/
_laravel-lessons/
**/_laravel-lessons/

# Media files: never commit course videos/audio
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.m4a

# Course transcripts: keep local only
transcript.txt
**/transcript.txt

